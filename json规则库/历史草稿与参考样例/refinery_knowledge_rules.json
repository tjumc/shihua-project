{
  "meta": {
    "rule_base_id": "huadong_12mtpa_rules",
    "refinery_id": "huadong_12mtpa_refinery",
    "version": "1.0",
    "scope": "planning_mass_balance_yield_blending_utility"
  },
  "industrial_axioms": {
    "overall_mass_balance": "sum(inlet_flows) + opening_inventory + purchases = sum(outlet_flows) + closing_inventory + losses",
    "unit_mass_balance": "unit_throughput * yield_i = product_stream_i for fixed-yield planning units",
    "blending_mass_balance": "sum(component_to_product_flows) = product_total_flow",
    "capacity_limit": "capacity_min <= unit_throughput <= capacity_max",
    "inventory_limit": "0 <= inventory <= tank_capacity",
    "utility_balance": "utility_consumption = unit_throughput * utility_factor",
    "hydrogen_balance": "hydrogen_production + purchase >= hydrogen_consumption + loss"
  },
  "optimization_objectives": [
    "maximize_margin",
    "minimize_energy_and_hydrogen_cost",
    "minimize_constraint_violation_when_infeasible"
  ],
  "unit_operation_rules": {
    "CDU1": {
      "mode": "fixed_yield",
      "yield_reference": "spec_library.units.CDU1.yields",
      "special_constraints": [
        "crude_blend must be defined before CDU processing",
        "vacuum_residue can be routed to RHT1 or DCU1",
        "vgo can be routed to FCC or HCU pool"
      ]
    },
    "FCC1": {
      "mode": "fixed_yield",
      "yield_reference": "spec_library.units.FCC1.yields",
      "special_constraints": [
        "fcc_feed_vgo sulfur should be below unit sulfur tolerance",
        "lpg_c3c4 split should support ALKY1 and MTBE1 feed availability"
      ]
    },
    "FCC2": {
      "mode": "fixed_yield",
      "yield_reference": "spec_library.units.FCC2.yields"
    },
    "HCU1": {
      "mode": "fixed_yield",
      "yield_reference": "spec_library.units.HCU1.yields",
      "hydrogen_consumption_factor_reference": "spec_library.units.HCU1.utilities.hydrogen_nm3_per_ton",
      "special_constraints": [
        "tail oil may recycle to FCC or fuel oil pool"
      ]
    },
    "RHT1": {
      "mode": "fixed_yield",
      "yield_reference": "spec_library.units.RHT1.yields",
      "hydrogen_consumption_factor_reference": "spec_library.units.RHT1.utilities.hydrogen_nm3_per_ton"
    },
    "DCU1": {
      "mode": "fixed_yield",
      "yield_reference": "spec_library.units.DCU1.yields",
      "special_constraints": [
        "petroleum_coke is a terminal product",
        "coker_gasoil may route to FCC or HCU feed pool"
      ]
    },
    "CRU1": {
      "mode": "fixed_yield",
      "yield_reference": "spec_library.units.CRU1.yields",
      "special_constraints": [
        "heavy_naphtha_reforming_feed sulfur must be under pretreat threshold",
        "hydrogen from CRU1 contributes to refinery hydrogen network"
      ]
    },
    "GHT1": {
      "mode": "quality_upgrading",
      "yield_reference": "spec_library.units.GHT1.yields",
      "quality_shift_rules": {
        "sulfur_reduction_factor": 0.08,
        "ron_loss": 1.5
      }
    },
    "DHT1": {
      "mode": "quality_upgrading",
      "yield_reference": "spec_library.units.DHT1.yields",
      "quality_shift_rules": {
        "sulfur_reduction_factor": 0.03,
        "cetane_improvement": 3.0
      }
    },
    "DHT2": {
      "mode": "quality_upgrading",
      "yield_reference": "spec_library.units.DHT2.yields",
      "quality_shift_rules": {
        "sulfur_reduction_factor": 0.03,
        "cetane_improvement": 3.0
      }
    },
    "JHT1": {
      "mode": "quality_upgrading",
      "yield_reference": "spec_library.units.JHT1.yields",
      "quality_shift_rules": {
        "sulfur_reduction_factor": 0.1,
        "smoke_point_improvement": 2.5
      }
    },
    "SZORB1": {
      "mode": "quality_upgrading",
      "yield_reference": "spec_library.units.SZORB1.yields",
      "quality_shift_rules": {
        "sulfur_reduction_factor": 0.06,
        "ron_loss": 0.3
      }
    },
    "ALKY1": {
      "mode": "conversion",
      "yield_reference": "spec_library.units.ALKY1.yields"
    },
    "MTBE1": {
      "mode": "conversion",
      "yield_reference": "spec_library.units.MTBE1.yields"
    }
  },
  "blending_rules": {
    "gasoline_92": {
      "pool": "GASOLINE_BLEND",
      "components_reference": "spec_library.products.gasoline_92.allowed_components",
      "property_constraints": {
        "RON": {
          "type": "volume_weighted_average_min",
          "min": 92.0
        },
        "sulfur_ppm": {
          "type": "mass_weighted_average_max",
          "max": 10.0
        },
        "benzene_vol_pct": {
          "type": "volume_weighted_average_max",
          "max": 1.0
        },
        "aromatics_vol_pct": {
          "type": "volume_weighted_average_max",
          "max": 35.0
        },
        "olefins_vol_pct": {
          "type": "volume_weighted_average_max",
          "max": 24.0
        }
      }
    },
    "gasoline_95": {
      "pool": "GASOLINE_BLEND",
      "components_reference": "spec_library.products.gasoline_95.allowed_components",
      "property_constraints": {
        "RON": {
          "type": "volume_weighted_average_min",
          "min": 95.0
        },
        "sulfur_ppm": {
          "type": "mass_weighted_average_max",
          "max": 10.0
        },
        "benzene_vol_pct": {
          "type": "volume_weighted_average_max",
          "max": 1.0
        },
        "aromatics_vol_pct": {
          "type": "volume_weighted_average_max",
          "max": 35.0
        }
      }
    },
    "jet_a1": {
      "pool": "JET_BLEND",
      "components_reference": "spec_library.products.jet_a1.allowed_components",
      "property_constraints": {
        "sulfur_ppm": {
          "type": "mass_weighted_average_max",
          "max": 1500.0
        },
        "smoke_point_mm": {
          "type": "volume_weighted_average_min",
          "min": 25.0
        },
        "freezing_point_c": {
          "type": "worst_case_max",
          "max": -47.0
        },
        "density_20c": {
          "type": "volume_weighted_average_range",
          "min": 775.0,
          "max": 840.0
        }
      }
    },
    "diesel_vi": {
      "pool": "DIESEL_BLEND",
      "components_reference": "spec_library.products.diesel_vi.allowed_components",
      "property_constraints": {
        "sulfur_ppm": {
          "type": "mass_weighted_average_max",
          "max": 10.0
        },
        "cetane_index": {
          "type": "volume_weighted_average_min",
          "min": 49.0
        },
        "density_20c": {
          "type": "volume_weighted_average_range",
          "min": 810.0,
          "max": 860.0
        }
      }
    }
  },
  "routing_rules": [
    {
      "material": "vgo",
      "allowed_destinations": [
        "FCC1",
        "FCC2",
        "HCU1"
      ]
    },
    {
      "material": "vacuum_residue",
      "allowed_destinations": [
        "RHT1",
        "DCU1"
      ]
    },
    {
      "material": "hydrogen",
      "allowed_destinations": [
        "HCU1",
        "RHT1",
        "GHT1",
        "DHT1",
        "DHT2",
        "JHT1"
      ]
    },
    {
      "material": "lpg_c3c4",
      "allowed_destinations": [
        "ALKY1",
        "MTBE1",
        "lpg_product"
      ]
    }
  ],
  "soft_constraint_policy": {
    "allow_automatic_relaxation": true,
    "relaxable_constraints": [
      "minimum_product_demand",
      "blending_property_min",
      "blending_property_max",
      "unit_min_load"
    ],
    "non_relaxable_constraints": [
      "hard_material_balance",
      "non_negative_flow",
      "tank_capacity_upper_bound"
    ],
    "penalty_priority": {
      "mass_balance": 1000000.0,
      "product_quality": 100000.0,
      "demand_shortfall": 50000.0,
      "unit_min_load": 1000.0
    }
  },
  "utility_rules": {
    "steam_credit_negative_means_export": true,
    "hydrogen_purchase_allowed": true,
    "electricity_purchase_allowed": true,
    "water_and_steam_factors_reference": "spec_library.units.*.utilities"
  },
  "data_binding": {
    "topology_file": "refinery_topology.json",
    "spec_library_file": "refinery_spec_library.json"
  }
}
